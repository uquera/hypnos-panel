// Hypnos Panel — Schema de base de datos
// SQLite + Prisma v6

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── USUARIOS DEL PANEL ────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String
  role         String   @default("COBRADOR") // ADMIN | COBRADOR
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  pagosRegistrados  Pago[]          @relation("PagosRegistrados")
  pagosCustodiados  Pago[]          @relation("PagosCustodiados")
  gastosRegistrados Gasto[]         @relation("GastosRegistrados")
  gastosCustodiados Gasto[]         @relation("GastosCustodiados")
  retiros           Retiro[]
  custodiasIngreso  PagoCustodia[] @relation("CustodiasIngreso")

  @@map("users")
}

// ─── CLIENTES SaaS ────────────────────────────────────────────────────────────

model Cliente {
  id               String    @id @default(cuid())
  nombre           String                         // "Centro Bambú"
  dominio          String                         // "centrobambu.cl"
  apiUrl           String                         // "https://centrobambu.cl/api/gobernanza/licencia"
  masterKey        String                         // GOBERNANZA_MASTER_KEY de esa instancia
  plan             String    @default("BASICO")   // BASICO | PRO | ENTERPRISE | POS (Hypnos POS, CLP)
  fechaVencimiento DateTime
  suspendida       Boolean   @default(false)
  notasAdmin       String?
  emailContacto    String?                        // email del contacto para alertas de vencimiento
  activo           Boolean   @default(true)
  ultimoCheck      DateTime?                      // última verificación de salud
  ultimoCheckOk    Boolean?                       // resultado del último health check
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  pagos            Pago[]
  posCuentas       PosCuenta[]

  @@map("clientes")
}

// ─── PAGOS ────────────────────────────────────────────────────────────────────
// concepto: LICENCIA | MARKETING | DESARROLLO
// periodoInicio/periodoFin solo aplican a LICENCIA; son null para las demás verticales.

model Pago {
  id              String    @id @default(cuid())
  clienteId       String
  cliente         Cliente   @relation(fields: [clienteId], references: [id])
  concepto        String    @default("LICENCIA")  // LICENCIA | MARKETING | DESARROLLO
  conceptoDetalle String?                          // descripción libre para MARKETING / DESARROLLO
  monto           Float
  moneda          String    @default("USD")        // USD | CLP | EUR
  periodoInicio   DateTime?                        // solo LICENCIA
  periodoFin      DateTime?                        // solo LICENCIA
  fechaPago       DateTime  @default(now())
  comprobante     String?                          // nombre del archivo en uploads/comprobantes/
  comprobanteOk   Boolean?                         // null = no evaluado (carga anterior al validador)
  comprobanteNota String?                          // "verificado · monto, fecha" / "débil · falta…"
  comprobanteHash String?                          // sha256: detecta el mismo comprobante reusado
  notas           String?
  registradoPorId String
  registradoPor   User           @relation("PagosRegistrados", fields: [registradoPorId], references: [id])
  custodioId      String?                          // custodio único legacy (null = mismo que registradoPor)
  custodio        User?          @relation("PagosCustodiados", fields: [custodioId], references: [id])
  custodias       PagoCustodia[]                   // split de custodia entre varios usuarios
  createdAt       DateTime       @default(now())

  @@index([comprobanteHash])
  @@map("pagos")
}

// ─── SPLIT DE CUSTODIA ────────────────────────────────────────────────────────
// Un pago puede dividirse entre varios custodios, cada uno con su monto.
// Si existe al menos un registro aquí, tiene prioridad sobre custodioId.

model PagoCustodia {
  id      String @id @default(cuid())
  pagoId  String
  pago    Pago   @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  userId  String
  usuario User   @relation("CustodiasIngreso", fields: [userId], references: [id])
  monto   Float

  @@unique([pagoId, userId])
  @@map("pago_custodias")
}

// ─── GASTOS OPERATIVOS ────────────────────────────────────────────────────────
// categoria: HERRAMIENTA_IA | SOFTWARE | INFRAESTRUCTURA | PUBLICIDAD | OTRO

model Gasto {
  id              String   @id @default(cuid())
  concepto        String                           // descripción libre: "Claude Max", "Canva Pro"…
  categoria       String   @default("OTRO")        // HERRAMIENTA_IA | SOFTWARE | INFRAESTRUCTURA | PUBLICIDAD | OTRO
  monto           Float
  moneda          String   @default("USD")         // USD | CLP | EUR
  fecha           DateTime @default(now())
  comprobante     String?                          // archivo en uploads/comprobantes/
  comprobanteOk   Boolean?                         // revisión del comprobante: null = no evaluado (carga anterior al validador)
  comprobanteNota String?                          // resumen del chequeo: "verificado · monto, fecha" / "débil · falta…"
  comprobanteHash String?                          // sha256 del archivo: detecta el mismo comprobante reusado en otro gasto
  notas           String?
  registradoPorId String
  registradoPor   User     @relation("GastosRegistrados", fields: [registradoPorId], references: [id])
  custodioId      String?                          // quién pagó físicamente (null = mismo que registradoPor)
  custodio        User?    @relation("GastosCustodiados", fields: [custodioId], references: [id])
  createdAt       DateTime @default(now())

  @@index([comprobanteHash])
  @@map("gastos")
}

// ─── LOG DE ACTIVIDAD ─────────────────────────────────────────────────────────
// Tabla de auditoría. Denormalizada a propósito: si se archiva un cliente o
// se elimina un usuario, el log histórico permanece intacto.

model ActividadLog {
  id            String   @id @default(cuid())
  usuarioId     String
  usuarioNombre String
  clienteId     String?
  clienteNombre String?
  accion        String   // LICENCIA_SYNC | PAGO_REGISTRADO | RENOVACION | CLIENTE_CREADO | CLIENTE_ARCHIVADO
  detalle       String?
  createdAt     DateTime @default(now())

  @@map("actividad_log")
}

// ─── RETIROS ──────────────────────────────────────────────────────────────────
// Dinero que un integrante retira de la caja (sueldo, gastos personales, etc.)

model Retiro {
  id              String   @id @default(cuid())
  monto           Float
  moneda          String   @default("USD")        // USD | CLP | EUR
  fecha           DateTime @default(now())
  concepto        String?                          // "Sueldo quincenal", "Gastos personales"…
  registradoPorId String
  registradoPor   User     @relation(fields: [registradoPorId], references: [id])
  createdAt       DateTime @default(now())

  @@map("retiros")
}

// ─── LEADS DE LA LANDING ──────────────────────────────────────────────────────
// Solicitudes que entran por el formulario de hypnosapps.com/landing.
// El endpoint público POST /api/leads es el único que escribe aquí.
// estado: NUEVO | CONTACTADO | EN_CONVERSACION | GANADO | PERDIDO

model Lead {
  id        String   @id @default(cuid())
  negocio   String                            // "Bisodent"
  tipo      String   @default("")             // rubro que eligió: "Consulta / Terapia"…
  nombre    String                            // nombre de la persona que escribe
  whatsapp  String   @default("")
  email     String   @default("")
  origen    String   @default("landing")      // qué botón/sección originó el envío
  conLogo   Boolean  @default(false)          // si subió logo al probar el demo
  estado    String   @default("NUEVO")
  notas     String?                           // seguimiento interno
  ip        String   @default("")             // para el límite anti-spam por IP
  userAgent String   @default("")
  agendaId  String   @default("")             // id de la agenda gratis creada al registrarse (vínculo con AgendaBackup)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
  @@index([createdAt])
  @@index([ip, createdAt])
  @@map("leads")
}

// ─── RESPALDO EN LA NUBE DE LA AGENDA GRATIS ──────────────────────────────────
// La agenda de hypnosapps.com/demo vive en el navegador del dueño y envía aquí
// una copia (sin imágenes) para que no la pierda y para darle soporte.
// Público solo para ESCRIBIR (POST /api/agenda/sync, protegido por la clave de
// cada agenda); leer es exclusivo del panel (ADMIN).

model AgendaBackup {
  id              String   @id @default(cuid())
  agendaId        String   @unique              // id aleatorio generado en el navegador
  keyHash         String                        // sha256 de la clave secreta de esa agenda
  slug            String   @default("")         // clave estable de la agenda (slug del negocio original)
  negocio         String   @default("")
  email           String   @default("")         // del perfil de la agenda (para vincular con el lead)
  telefono        String   @default("")
  data            String                        // JSON completo de la agenda
  clientes        Int      @default(0)
  servicios       Int      @default(0)
  citas           Int      @default(0)
  movimientos     Int      @default(0)
  ultimaActividad DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@map("agenda_backups")
}

// ─── HYPNOS POS ───────────────────────────────────────────────────────────────
// App Android única para las máquinas TUU Pro 2: el negocio escribe su código y
// la app descarga su marca con GET /api/pos-app/config?code=<codigo>.
// Hypnos crea las cuentas (/admin/pos); cada negocio edita su marca en /pos/marca.
// Los PosUsuario NO son usuarios del panel: tienen su propia sesión (cookie hypnos_pos).

model PosCuenta {
  id                 String       @id @default(cuid())
  codigo             String       @unique                // "donaany": a-z0-9 y guiones, 3-30
  nombre             String                              // nombre visible en la app
  posUrl             String                              // https del sistema web del negocio (solo Hypnos lo cambia)
  logo               String?                             // archivo PNG en POS_UPLOAD_DIR (<id>.png)
  colorPrimario      String       @default("#f26522")
  colorTextoPrimario String       @default("#ffffff")    // texto sobre el color primario
  colorFondo         String       @default("#ffffff")
  colorTexto         String       @default("#1f2937")
  activo             Boolean      @default(true)         // false = suspendida (la app y el portal la rechazan)
  clienteId          String?                             // vínculo opcional con el Cliente de la gobernanza
  cliente            Cliente?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  cadenaId           String?                             // locales de un mismo dueño: vista "Mi cadena" del portal
  cadena             PosCadena?   @relation(fields: [cadenaId], references: [id], onDelete: SetNull)
  // Alta automática de la instancia (<codigo>.hypnosapps.com) con hypnos-pos-tenant.
  // Las cuentas creadas a mano (antes del alta automática, p. ej. donaany) quedan en MANUAL:
  // no se instalan ni se eliminan con el comando.
  estadoAlta         String       @default("MANUAL")     // MANUAL | PENDIENTE | INSTALANDO | LISTO | ERROR
  altaLog            String?                             // salida del comando, recortada (sin la master key)
  altaAt             DateTime?                           // inicio del último intento de instalación
  enPrueba           Boolean      @default(false)        // prueba gratis (14 días) aún sin primer pago
  whatsapp           String       @default("")           // WhatsApp del dueño (registro / ficha)
  origen             String       @default("ADMIN")      // ADMIN | REGISTRO (formulario público /pos/registro)
  tipo               String       @default("RESTAURANTE") // RESTAURANTE | ALMACEN (minimarket: se instala con --tipo almacen)
  terminosAt         DateTime?                           // aceptación de términos en el registro público
  precioMensual      Int?                                // CLP; null = POS_PRECIO_MENSUAL (precio especial por cuenta)
  eliminadaAt        DateTime?                           // eliminada (instancia respaldada y fuera de línea); se conserva el historial
  archivadaAt        DateTime?                           // fuera del tablero para no estorbar (suspendidos, impagos); no cambia licencia ni instancia
  // Onboarding (registro / crear restaurante): se pasa a hypnos-pos-tenant create.
  // Archivos en POS_ONBOARDING_DIR/<cuentaId>/ (por defecto uploads/pos-onboarding), fuera de public.
  menuUrl            String       @default("")           // menú online a importar (Fudo u otro)
  mesas              Int          @default(10)
  direccion          String       @default("")
  horario            String       @default("")
  archivoClientes    String?                             // "clientes.xlsx" | "clientes.csv" dentro de la carpeta de la cuenta
  archivoClientesNombre String    @default("")           // nombre original del archivo subido
  resultadoAlta      String?                             // JSON {menu:{ok,productos,error?}, clientes:{ok,importados}} del último create
  usuarios           PosUsuario[]
  comprobantes       PosComprobante[]
  avisos             PosAviso[]
  cobrosOnline       PosCobroOnline[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("pos_cuentas")
}

// Cadena: varios locales (PosCuenta, cada uno con su propio sistema) de un mismo dueño.
// Los correos listados (usuarios del portal) ven "Mi cadena": ventas de todos los locales
// sumadas, leídas de /api/gobernanza/resumen de cada local con su master key. Incluido, sin costo.
model PosCadena {
  id        String      @id @default(cuid())
  nombre    String
  correos   String      @default("")                // correos de los dueños, en minúsculas, separados por coma
  cuentas   PosCuenta[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("pos_cadenas")
}

// Comprobantes de transferencia que sube el dueño en /pos/pago. Hypnos los revisa
// en /admin/pos: aprobar crea el Pago (LICENCIA, CLP) y extiende la licencia.
// estado: PENDIENTE | APROBADO | RECHAZADO
model PosComprobante {
  id             String    @id @default(cuid())
  cuentaId       String
  cuenta         PosCuenta @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  archivo        String                              // nombre en POS_COMPROBANTES_DIR (uploads/pos-comprobantes)
  mime           String                              // image/jpeg | image/png | image/webp | application/pdf
  nombreOriginal String    @default("")
  montoDeclarado Float
  comentario     String?                             // nota opcional del dueño
  estado         String    @default("PENDIENTE")
  motivoRechazo  String?
  subidoPor      String    @default("")              // correo del PosUsuario que lo subió
  revisadoPor    String?                             // nombre del operador de Hypnos
  revisadoAt     DateTime?
  pagoId         String?                             // Pago creado al aprobar
  createdAt      DateTime  @default(now())

  @@index([estado])
  @@index([cuentaId])
  @@map("pos_comprobantes")
}

// Cobros en línea de la licencia con TUU (Webpay). Cada intento de pago tiene una referencia
// única (x_reference) y el monto lo calcula el servidor. El callback firmado de TUU es la única
// prueba de pago: marca PAGADO con escritura condicional (idempotente) y renueva la licencia.
// estado: PENDIENTE | PAGADO | FALLIDO | ERROR (pagado en TUU pero no se pudo aplicar: revisar)
model PosCobroOnline {
  id         String    @id @default(cuid())
  referencia String    @unique                       // HP-<YYYYMMDD vencimiento>-<aleatorio>
  cuentaId   String
  cuenta     PosCuenta @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  periodo    String                                  // vencimiento (YYYY-MM-DD, Chile) al crear el cobro
  meses      Int
  monto      Int                                     // CLP, calculado en el servidor
  estado     String    @default("PENDIENTE")
  origen     String    @default("PORTAL")            // PORTAL | LINK (correo / link enviado por Hypnos)
  ambiente   String    @default("prod")              // TUU_ONLINE_ENV al crear: test | prod
  resultado  String?                                 // último x_result recibido
  detalle    String?                                 // error al aplicar o motivo del rechazo (sin secretos)
  pagoId     String?                                 // Pago (LICENCIA) creado al aplicar
  hasta      DateTime?                               // nuevo vencimiento aplicado
  pagadoAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([cuentaId])
  @@index([estado])
  @@map("pos_cobros_online")
}

// Avisos automáticos del cron de cobro (para no repetirlos).
// tipo: PRUEBA_3 | PRUEBA_1 | COBRO_5 | VENCE_HOY | SUSPENSION
// periodo: fecha de vencimiento (YYYY-MM-DD, hora de Chile) a la que se refiere el aviso.
model PosAviso {
  id        String    @id @default(cuid())
  cuentaId  String
  cuenta    PosCuenta @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  tipo      String
  periodo   String
  createdAt DateTime  @default(now())

  @@unique([cuentaId, tipo, periodo])
  @@map("pos_avisos")
}

// Sub-cuentas del negocio. passwordHash null = invitado que aún no crea su contraseña.
// rol: DUENO (edita la marca e invita EDITOR) | EDITOR (solo edita la marca)
model PosUsuario {
  id            String     @id @default(cuid())
  cuentaId      String
  cuenta        PosCuenta  @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  nombre        String
  email         String     @unique                       // siempre en minúsculas
  passwordHash  String?
  rol           String     @default("EDITOR")
  activo        Boolean    @default(true)
  ultimoIngreso DateTime?
  tokens        PosToken[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([cuentaId])
  @@map("pos_usuarios")
}

// Enlaces de invitación (7 días) y recuperación (1 hora). Se guarda solo el
// sha256 del token; cada enlace sirve una vez (usadoEn) y uno nuevo anula los anteriores.
// tipo: INVITACION | RECUPERACION
model PosToken {
  id        String     @id @default(cuid())
  usuarioId String
  usuario   PosUsuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      String
  tokenHash String     @unique
  expiraEn  DateTime
  usadoEn   DateTime?
  createdAt DateTime   @default(now())

  @@index([usuarioId])
  @@map("pos_tokens")
}

// ─── NextAuth — sesiones JWT (no requiere tablas adicionales) ─────────────────

// Ajustes de Hypnos POS editables desde el panel (clave → valor JSON).
// linksPago: { "20000": "https://…", "40000": "…", "45000": "…" } links de cobro TUU por monto.
model PosConfig {
  clave     String   @id
  valor     String
  updatedAt DateTime @updatedAt

  @@map("pos_config")
}
